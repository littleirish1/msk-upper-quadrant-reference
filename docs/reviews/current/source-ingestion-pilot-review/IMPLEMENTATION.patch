+def probable_key(filename: str) -> str:
+    stem = Path(filename).stem.lower()
+    stem = re.sub(r"\b(?:copy|final|revised|updated|old|new|version|ver|v)\s*\d*\b", "", stem)
+    stem = re.sub(r"\b20\d{2}\b|\(\d+\)", "", stem)
+    return re.sub(r"[^a-z0-9]+", "", stem)
