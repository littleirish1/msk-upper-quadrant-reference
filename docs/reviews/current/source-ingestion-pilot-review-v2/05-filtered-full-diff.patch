+                safe, sensitive = sanitize_tracked_line(line, names, maximum_length=limit)
+                if sensitive or not safe: suppressed += 1; continue
+                citation = safe[:limit]
+                key = re.sub(r"\W+", "", citation).lower()
+                if not key or key in seen: continue
