+                        warnings["unsupported-cell-type"] += 1; value = raw
+                    if any(_local_name(node.tag) == "f" for node in cell): warnings["formula-present-uncomputed"] += 1
+                    if value: cells.append(f"{ref}={value}")
+                if cells: rows.append(" | ".join(cells))
