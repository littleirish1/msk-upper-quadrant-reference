+
+export const candidateReferenceV2Schema = z.object({
+  candidateReferenceId: z.string().regex(/^ref-[a-z0-9-]+$/),
+  sourceId: displaySourceIdSchema,
+  sourceChecksum: fullChecksumSchema,
